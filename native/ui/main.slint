import { ScrollView, LineEdit, ListView, ComboBox } from "std-widgets.slint";

export struct ProtocolFrameRow {
    stamp: string,
    direction: string,
    payload: string,
    preview: string,
}
export struct AccountRow {
    id: string,
    name: string,
    initial: string,
    status: string,
    online: bool,
    level: string,
    pokemon: string,
    pokemon-level: string,
    hp-percent: int,
    bonus-label: string,
    bonus-vip: bool,
    bonus-guild: bool,
    bonus-guild-boost: bool,
    bonus-twitch: bool,
    bonus-event: bool,
    pokemon-art: image,
    has-pokemon-art: bool,
    hp: string,
    hunt: string,
    xp: string,
    gold: string,
    xp-rate: string,
    gold-rate: string,
    potion: string,
    ball: string,
    mode: string,
    pending: string,
    vip: string,
    session-kills: string,
    session-captures: string,
    session-xp: string,
    session-pokemon-xp: string,
    session-gold: string,
    session-elapsed: string,
    session-shinies: string,
}
export struct HuntRow {
    slug: string,
    name: string,
    level: string,
    region: string,
    area: string,
    species: string,
    rank: string,
    kills-rate: string,
    seconds-per-kill: string,
    primary-art: image,
    has-primary-art: bool,
    xp-trainer: string,
    xp-pokemon: string,
    gold-rate: string,
    confidence: string,
    current: bool,
}
export struct HuntBonusRow {
    kind: int,
    label: string,
    value: string,
    active: bool,
}
export struct InventoryRow {
    id: string,
    owner: string,
    title: string,
    quantity: string,
    category: string,
    details: string,
    artwork: image,
    has-artwork: bool,
    is-pokemon: bool,
    locked: bool,
}
export struct InventoryGridRow {
    cells: [InventoryRow],
}
export struct MarketRow {
    name: string,
    listings: string,
    quantity: string,
    gold: string,
    orbs: string,
}
export struct MarketHistoryRow {
    date: string,
    item: string,
    participants: string,
    amount: string,
    currency: string,
}
export struct MarketTopRow {
    item: string,
    count: string,
    quantity: string,
    average: string,
}
export struct MarketPurchaseRow {
    item: string,
    outcome: string,
    quantity: string,
    cost: string,
    currency: string,
}
export struct SessionDropRow {
    label: string,
    quantity: string,
}
export struct SniperRuleRow {
    id: string,
    label: string,
    price: string,
    budget: string,
    spent: string,
    quantity: string,
    enabled: bool,
}
export struct LiveRow {
    name: string,
    channel: string,
    viewers: string,
    platform: string,
}
export struct RefillRuleRow {
    kind: string,
    item-id: string,
    minimum: string,
    quantity: string,
    status: string,
}
export struct AutomationRow {
    key: string,
    label: string,
    description: string,
    enabled: bool,
}

component WoodButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback clicked;
    height: 39px;
    min-width: 112px;
    border-width: 2px;
    border-radius: 6px;
    border-color: selected ? #f9d878 : #935541;
    background: !enabled ? #49343b : selected ? #79388e : touch.has-hover ? #804535 : #5c3236;
    Text {
        text: root.label;
        color: !root.enabled ? #b79e9d : #fff0d5;
        font-size: 13px;
        font-weight: 650;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}
component NavigationButton inherits Rectangle {
    in property <string> name;
    in property <image> artwork;
    in property <bool> active;
    callback clicked;
    height: 52px;
    border-width: 2px;
    
    border-radius: 7px;
    border-color: root.active ? #ffce6b : #8a493a;
    background: root.active ? #802e9c : nav-touch.has-hover ? #633648 : #3c2331;
    HorizontalLayout {
        padding-left: 5px;
        padding-right: 8px;
        spacing: 9px;
        Image {
            source: root.artwork;
            width: 38px;
            height: 38px;
            image-fit: contain;
        }
        Text {
            text: root.name;
            color: #fff0dd;
            font-size: 14px;
            font-weight: root.active ? 760 : 540;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
    nav-touch := TouchArea { clicked => { root.clicked(); } }
}
component MetricTile inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <image> artwork;
    height: 95px;
    min-width: 135px;
    border-radius: 8px;
    border-width: 2px;
    border-color: #965740;
    background: #452733;
    HorizontalLayout {
        padding: 12px;
        spacing: 8px;
        Image { source: root.artwork; width: 38px; height: 38px; image-fit: contain; }
        VerticalLayout {
            spacing: 4px;
            Text { text: root.title; color: #e7bd99; font-size: 12px; }
            Text { text: root.value; color: #fff1d4; font-size: 20px; font-weight: 750; }
        }
    }
}
component PageBanner inherits Rectangle {
    in property <string> title;
    height: 141px;
    border-width: 2px;
    border-color: #a56540;
    background: #322230;
    Image {
        source: @image-url("../../src/assets/pokeidle-theme/backgrounds/shared-header-scenery.png");
        width: parent.width;
        height: parent.height;
        image-fit: cover;
    }
    Image {
        x: 18px;
        y: 20px;
        width: 384px;
        height: 91px;
        source: @image-url("../../src/assets/pokeidle-theme/backgrounds/shared-header-titleboard.png");
        image-fit: fill;
    }
    Text {
        x: 64px;
        y: 39px;
        width: 294px;
        height: 48px;
        text: root.title;
        color: #fff0bd;
        font-size: 26px;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
component SectionHeading inherits Text {
    in property <string> label;
    text: root.label;
    color: #fff1d3;
    font-size: 19px;
    font-weight: 750;
    height: 34px;
    vertical-alignment: center;
}
component LiveStreamCard inherits Rectangle {
    in property <LiveRow> item;
    callback open(string, string);
    height: 119px;
    background: #452b38;
    border-color: #9f6648;
    border-width: 2px;
    border-radius: 8px;
    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 10px;
            Rectangle {
                width: 42px; height: 42px;
                background: root.item.platform == "Kick" ? #3c6539 : #6b3a86;
                border-radius: 8px;
                if root.item.platform == "Twitch" : Image {
                    source: @image-url("../../src/assets/pokeidle-theme/backgrounds/icon-twitch.png");
                    width: parent.width;
                    height: parent.height;
                    image-fit: contain;
                }
                if root.item.platform == "Kick" : Text {
                    text: "K";
                    color: #fff4d5;
                    font-size: 26px;
                    font-weight: 840;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: root.item.name;
                    color: #fff0d9;
                    font-weight: 750;
                    font-size: 16px;
                }
                Text {
                    text: root.item.platform == "Twitch"
                        ? "@" + root.item.channel : root.item.channel;
                    color: #d1aea2;
                    font-size: 12px;
                }
            }
            Text {
                text: root.item.viewers + " espectadores";
                color: #c7e6b3;
                horizontal-alignment: right;
                vertical-alignment: center;
                font-size: 12px;
            }
        }
        HorizontalLayout {
            spacing: 10px;
            Text {
                text: "●  Ao vivo";
                color: #a8e4b8;
                font-size: 12px;
                vertical-alignment: center;
            }
            WoodButton {
                label: "Abrir canal ↗";
                clicked => { root.open(root.item.platform, root.item.channel); }
            }
        }
    }
}

component HuntIvTile inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <image> icon;
    height: 66px;
    min-width: 76px;
    background: #31252e;
    border-width: 1px;
    border-color: #986145;
    border-radius: 6px;
    VerticalLayout {
        padding: 6px;
        spacing: 5px;
        HorizontalLayout {
            spacing: 4px;
            Image { source: root.icon; width: 21px; height: 21px; image-fit: contain; }
            Text { text: root.label; color: #d9b8a1; font-size: 10px; }
        }
        Text {
            text: root.value;
            font-weight: 800;
            color: #fff0d8;
            font-size: 17px;
            horizontal-alignment: center;
        }
    }
}

component AccountMiniStat inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <image> artwork;
    height: 50px;
    border-color: #a46c4655;
    border-width: 1px;
    background: #3a2833;
    HorizontalLayout {
        padding: 6px;
        spacing: 7px;
        Image { source: root.artwork; width: 28px; height: 28px; image-fit: contain; }
        VerticalLayout {
            spacing: 3px;
            Text { text: root.label; color: #e8c199; font-size: 11px; }
            Text { text: root.value; color: #fff0d3; font-size: 14px; font-weight: 760; }
        }
    }
}

component AccountCard inherits Rectangle {
    in property <AccountRow> item;
    in property <bool> session-mode: false;
    callback details;
    callback connect;
    width: 49%;
    min-width: 348px;
    height: 366px;
    border-width: 3px;
    border-color: root.item.online ? #c87543 : #78534d;
    border-radius: 9px;
    background: #432637;
    VerticalLayout {
        padding: 13px;
        spacing: 8px;
        Rectangle {
            height: 65px;
            background: #703b43;
            border-width: 1px;
            border-color: #d4864c;
            border-radius: 6px;
            HorizontalLayout {
                padding: 7px;
                spacing: 9px;
                Rectangle {
                    width: 42px;
                    height: 42px;
                    background: #98475e;
                    border-width: 2px;
                    border-color: #f6c25d;
                    border-radius: 7px;
                    Text {
                        text: root.item.initial;
                        font-size: 23px;
                        font-weight: 800;
                        color: #fff5dd;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                VerticalLayout {
                    spacing: 5px;
                    HorizontalLayout {
                        spacing: 7px;
                        Text { text: root.item.name; color: #fff2d6; font-size: 17px; font-weight: 750; }
                        Text { text: root.item.bonus-label; color: #a6ead3; font-size: 11px; font-weight: 770; }
                    }
                    HorizontalLayout {
                        spacing: 5px;
                        Text {
                            text: root.item.status;
                            color: root.item.online ? #a4edbb : #f1ad91;
                            font-size: 12px;
                            font-weight: 700;
                        }
                        if root.item.bonus-vip : Image { source: @image-url("../../src/assets/pokeidle-theme/backgrounds/where-hunt-vip.png"); width: 18px; height: 18px; image-fit: contain; }
                        if root.item.bonus-guild : Image { source: @image-url("../../src/assets/pokeidle-theme/backgrounds/where-hunt-guild.png"); width: 18px; height: 18px; image-fit: contain; }
                        if root.item.bonus-guild-boost : Image { source: @image-url("../../src/assets/pokeidle-theme/backgrounds/where-hunt-guild-boost.png"); width: 18px; height: 18px; image-fit: contain; }
                        if root.item.bonus-twitch : Image { source: @image-url("../../src/assets/pokeidle-theme/backgrounds/icon-twitch.png"); width: 18px; height: 18px; image-fit: contain; }
                        if root.item.bonus-event : Text { text: "★"; color: #f5cb80; font-size: 14px; }
                    }
                }
                Text {
                    text: root.item.mode;
                    color: #ffe3b2;
                    font-size: 12px;
                    font-weight: 750;
                    horizontal-alignment: right;
                }
            }
        }
        if root.session-mode : VerticalLayout {
            spacing: 10px;
            Rectangle {
                height: 53px;
                background: #30202e;
                border-color: #976041;
                border-width: 1px;
                HorizontalLayout {
                    padding: 9px;
                    Text { text: "Tempo da sessão"; color: #ead3bb; vertical-alignment: center; }
                    Text { text: root.item.session-elapsed; color: #ffdc8c; font-size: 18px; font-weight: 750; horizontal-alignment: right; vertical-alignment: center; }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                AccountMiniStat { label: "Kills"; value: root.item.session-kills; artwork: @image-url("../../src/assets/pokeidle-theme/backgrounds/icon-hunt.png"); }
                AccountMiniStat { label: "Capturas"; value: root.item.session-captures; artwork: @image-url("../../src/assets/pokeidle-theme/backgrounds/icon-background.png"); }
                AccountMiniStat { label: "Shinies"; value: root.item.session-shinies; artwork: @image-url("../../src/assets/pokeidle-theme/backgrounds/icon-diamond.png"); }
            }
            AccountMiniStat { label: "XP Treinador / Pokémon"; value: root.item.session-xp + " / " + root.item.session-pokemon-xp; artwork: @image-url("../../src/assets/pokeidle-theme/backgrounds/icon-level.png"); }
            AccountMiniStat { label: "Gold da sessão"; value: root.item.session-gold; artwork: @image-url("../../src/assets/pokeidle-theme/backgrounds/icon-gold.png"); }
        }
        if !root.session-mode : HorizontalLayout {
            spacing: 12px;
            Rectangle {
                width: 41%;
                height: 205px;
                background: #2b2233;
                border-color: #a46f4b;
                border-width: 1px;
                border-radius: 6px;
                Image {
                    source: @image-url("../../src/assets/pokeidle-theme/backgrounds/pokemon-battle-backdrop.png");
                    width: parent.width;
                    height: parent.height;
                    image-fit: cover;
                }
                if root.item.has-pokemon-art : Image {
                    source: root.item.pokemon-art;
                    width: parent.width;
                    height: parent.height;
                    image-fit: contain;
                }
                if !root.item.has-pokemon-art : Text {
                    text: "?";
                    color: #f5deb5;
                    font-size: 50px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            VerticalLayout {
                spacing: 7px;
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: root.item.pokemon; color: #fff0d9; font-size: 15px; font-weight: 750; }
                    Text { text: root.item.pokemon-level; color: #e7cbb0; font-size: 12px; }
                }
                HorizontalLayout {
                    spacing: 7px;
                    Text { text: "HP"; color: #eac3b6; font-size: 12px; }
                    Rectangle {
                        height: 8px;
                        horizontal-stretch: 1;
                        background: #2a1721;
                        border-color: #a76b3d;
                        border-width: 1px;
                        Rectangle {
                            height: parent.height - 2px;
                            width: (parent.width - 2px) * root.item.hp-percent / 100;
                            x: 1px;
                            y: 1px;
                            background: #50bf74;
                        }
                    }
                    Text { text: root.item.hp; color: #f3d3b6; font-size: 12px; font-weight: 750; }
                }
                HorizontalLayout {
                    spacing: 3px;
                    AccountMiniStat { label: "XP/h"; value: root.item.xp-rate; artwork: @image-url("../../src/assets/pokeidle-theme/backgrounds/icon-level.png"); }
                    AccountMiniStat { label: "Gold/h"; value: root.item.gold-rate; artwork: @image-url("../../src/assets/pokeidle-theme/backgrounds/icon-gold.png"); }
                }
                HorizontalLayout {
                    spacing: 3px;
                    AccountMiniStat { label: "Potions"; value: root.item.potion; artwork: @image-url("../../src/assets/pokeidle-theme/backgrounds/icon-background.png"); }
                    AccountMiniStat { label: "Balls"; value: root.item.ball; artwork: @image-url("../../src/assets/pokeidle-theme/backgrounds/icon-hunt.png"); }
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.item.hunt;
                color: #f4d499;
                font-size: 12px;
                horizontal-stretch: 1;
                vertical-alignment: center;
                overflow: elide;
            }
            WoodButton { label: "Detalhes"; height: 31px; clicked => { root.details(); } }
            WoodButton { label: "Conectar"; height: 31px; enabled: !root.item.online; clicked => { root.connect(); } }
        }
    }
}
component DisplayRow inherits Rectangle {
    in property <string> heading;
    in property <string> subheading;
    in property <string> value;
    height: 58px;
    border-width: 1px;
    border-color: #81503d;
    background: #35222c;
    HorizontalLayout {
        padding-left: 12px; padding-right: 12px;
        spacing: 10px;
        VerticalLayout {
            spacing: 4px;
            Text { text: root.heading; color: #fff1dc; font-size: 15px; font-weight: 700; }
            Text { text: root.subheading; color: #cba99e; font-size: 12px; }
        }
        Text { text: root.value; color: #ffce77; font-weight: 650; horizontal-alignment: right; vertical-alignment: center; }
    }
}
component ToggleRow inherits Rectangle {
    in property <AutomationRow> item;
    callback toggled(string, bool);
    height: 82px;
    border-width: 1px;
    border-radius: 7px;
    border-color: #835140;
    background: #452833;
    HorizontalLayout {
        padding: 12px;
        spacing: 10px;
        VerticalLayout {
            spacing: 4px;
            Text { text: root.item.label; color: #fff0d6; font-weight: 700; font-size: 16px; }
            Text { text: root.item.description; color: #caa5a3; font-size: 12px; wrap: word-wrap; }
        }
        Rectangle {
            width: 82px;
            height: 34px;
            border-radius: 17px;
            border-color: root.item.enabled ? #f3ce70 : #805958;
            border-width: 2px;
            background: root.item.enabled ? #743a91 : #392832;
            Text {
                text: root.item.enabled ? "Ligado" : "Desligado";
                color: #ffecca;
                font-weight: 650;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea { clicked => { root.toggled(root.item.key, !root.item.enabled); } }
        }
    }
}

export component ManagerWindow inherits Window {
    title: "Pokeidle Manager";
    width: 1400px;
    height: 900px;
    background: #160e17;
    default-font-family: "Segoe UI";
    in-out property <int> page: 0;
    in-out property <int> selected-account: 0;
    in-out property <bool> showing-detail: false;
    in-out property <string> hunt-search: "";
    in-out property <int> hunt-ranking-mode: 0;
    in-out property <[string]> hunt-regions: ["Todas"];
    in-out property <string> hunt-region-filter: "Todas";
    in-out property <[HuntBonusRow]> hunt-bonuses: [];
    in-out property <string> hunt-result-count: "0";
    in-out property <string> hunt-iv-hp: "—";
    in-out property <string> hunt-iv-atk: "—";
    in-out property <string> hunt-iv-def: "—";
    in-out property <string> hunt-iv-sp-atk: "—";
    in-out property <string> hunt-iv-sp-def: "—";
    in-out property <string> hunt-iv-speed: "—";
    in-out property <string> hunt-model-status: "Calculando..." ;
    in-out property <string> inventory-search: "";
    in-out property <int> inventory-tab: 0;
    in-out property <int> inventory-category: 0;
    in-out property <bool> inventory-all-accounts: true;
    in-out property <int> pokemon-sort: 0;
    in-out property <string> pokemon-type-filter: "";
    in-out property <string> pokemon-min-iv: "";
    in-out property <string> sale-id: "";
    in-out property <string> sale-name: "";
    in-out property <bool> confirm-sell-all: false;
    in-out property <bool> session-mode: false;
    in-out property <bool> connect-next-available: true;
    in-out property <[AccountRow]> accounts: [];
    in-out property <[HuntRow]> hunts: [];
    in-out property <[InventoryRow]> inventory: [];
    in-out property <[InventoryGridRow]> inventory-grid: [];
    in-out property <[MarketRow]> market: [];
    in-out property <[MarketHistoryRow]> market-history: [];
    in-out property <[MarketTopRow]> market-top-sales: [];
    in-out property <[MarketPurchaseRow]> market-purchases: [];
    in-out property <int> market-view: 0;
    in-out property <string> market-history-status: "Aguardando histórico";
    in-out property <[SniperRuleRow]> sniper-rules: [];
    in-out property <string> sniper-item-id: "";
    in-out property <string> sniper-max-price: "";
    in-out property <string> sniper-budget: "0";
    in-out property <string> sniper-min-balance: "0";
    in-out property <int> sniper-currency: 0;
    in-out property <[LiveRow]> lives: [];
    in-out property <[LiveRow]> twitch-lives: [];
    in-out property <[LiveRow]> kick-lives: [];
    in-out property <string> lives-source-status: "Aguardando uma conta leitora";
    in-out property <string> lives-updated-at: "—";
    in-out property <bool> lives-stale: false;
    in-out property <string> twitch-live-count: "0";
    in-out property <string> kick-live-count: "0";
    in-out property <[AutomationRow]> automations: [];
    in-out property <int> potion-threshold-percent: 40;
    in-out property <string> potion-selection: "";
    in-out property <string> ball-selection: "";
    in-out property <string> automation-last-error: "";
    in-out property <[RefillRuleRow]> refill-rules: [];
    in-out property <int> refill-kind: 0;
    in-out property <string> refill-item-id: "";
    in-out property <string> refill-minimum: "500";
    in-out property <string> refill-quantity: "1000";
    in-out property <string> total-xp: "0";
    in-out property <string> total-gold-rate: "0";
    in-out property <string> total-gold: "0";
    in-out property <string> total-gems: "0";
    in-out property <string> connected-accounts: "0/4";
    in-out property <string> status-line: "Pronto";
    in-out property <string> native-version: "—";
    in-out property <bool> developer-mode: false;
    in-out property <bool> protocol-paused: false;
    in-out property <int> protocol-direction: 0;
    in-out property <string> protocol-search: "";
    in-out property <string> protocol-count: "0/500";
    in-out property <[ProtocolFrameRow]> protocol-frames: [];
    in-out property <int> ui-refresh-seconds: 1;
    in-out property <bool> restore-profiles-on-launch: true;
    in-out property <string> market-status: "Aguardando conexão";
    in-out property <string> twitch-irc-status: "Twitch IRC desativado";
    in-out property <string> current-account: "Game 1";
    in-out property <string> current-level: "—";
    in-out property <string> current-hunt: "—";
    in-out property <string> current-xp: "0";
    in-out property <string> current-gold: "0";
    in-out property <string> current-pokemon: "—";
    in-out property <image> current-pokemon-art;
    in-out property <string> current-status: "Offline";
    in-out property <string> current-orbs: "0";
    in-out property <string> current-diamonds: "0";
    in-out property <string> current-vip: "—";
    in-out property <string> current-pokemon-level: "—";
    in-out property <string> current-pokemon-types: "—";
    in-out property <string> current-pokemon-hp: "—";
    in-out property <string> current-pokemon-xp: "—";
    in-out property <string> current-pokemon-quality: "—";
    in-out property <string> current-pokemon-power: "—";
    in-out property <string> current-wild: "Nenhum encontro ativo";
    in-out property <string> current-wild-hp: "—";
    in-out property <string> current-xp-rate: "0";
    in-out property <string> current-gold-rate: "0";
    in-out property <string> current-kills: "0";
    in-out property <string> current-captures: "0";
    in-out property <string> current-potion-rate: "0";
    in-out property <string> current-balls-used: "0";
    in-out property <string> current-session-time: "—";
    in-out property <string> current-session-trainer-xp: "0";
    in-out property <string> current-session-pokemon-xp: "0";
    in-out property <string> current-session-gold: "0";
    in-out property <string> current-session-kills: "0";
    in-out property <string> current-session-captures: "0";
    in-out property <string> current-shiny-seen: "0";
    in-out property <string> current-shiny-captured: "0";
    in-out property <[SessionDropRow]> session-drops: [];
    in-out property <bool> confirm-reset-session: false;
    in-out property <bool> auto-potion: false;
    in-out property <bool> auto-revive: false;
    in-out property <bool> auto-return: false;
    in-out property <bool> auto-sell: false;

    callback connect-account(int);
    callback connect-next-account;
    callback save-native-settings(int, bool);
    callback toggle-developer-mode(bool);
    callback clear-protocol-frames;
    callback copy-protocol-frame(string);
    callback travel(string);
    callback toggle-automation(string, bool);
    callback set-potion-threshold(int);
    callback save-combat-selection(string, string);
    callback update-refill-rule;
    callback sell-pokemon(string);
    callback sell-all-pokemon;
    callback reset-session;
    callback return-center;
    callback refresh-market;
    callback save-sniper-rule;
    callback delete-sniper-rule(string);
    callback toggle-sniper-rule(string, bool);
    callback open-stream(string, string);
    callback open-community;
    callback route-changed(int);
    callback selected-account-changed(int);

    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: 232px;
            background: #211821;
            
            border-color: #b67245;
            VerticalLayout {
                spacing: 0px;
                Image {
                    source: @image-url("../../src/assets/pokeidle-theme/backgrounds/sidebar-brand.png");
                    height: 132px;
                    image-fit: contain;
                }
                Rectangle {
                    height: 490px;
                    background: #241a25;
                    VerticalLayout {
                        padding: 8px;
                        spacing: 8px;
                        NavigationButton { name: "Dashboard"; artwork: @image-url("../../src/assets/pokeidle-theme/backgrounds/menu-dashboard.png"); active: root.page == 0 && !root.showing-detail; clicked => { root.page = 0; root.showing-detail = false; root.route-changed(0); } }
                        NavigationButton { name: "Automações"; artwork: @image-url("../../src/assets/pokeidle-theme/backgrounds/menu-automation.png"); active: root.page == 2 && !root.showing-detail; clicked => { root.page = 2; root.showing-detail = false; root.route-changed(2); } }
                        NavigationButton { name: "Inventários"; artwork: @image-url("../../src/assets/pokeidle-theme/backgrounds/menu-inventory.png"); active: root.page == 3 && !root.showing-detail; clicked => { root.page = 3; root.showing-detail = false; root.route-changed(3); } }
                        NavigationButton { name: "Mercado"; artwork: @image-url("../../src/assets/pokeidle-theme/backgrounds/menu-market.png"); active: root.page == 4 && !root.showing-detail; clicked => { root.page = 4; root.showing-detail = false; root.route-changed(4); } }
                        NavigationButton { name: "Lives"; artwork: @image-url("../../src/assets/ui-icons/live-icon.png"); active: root.page == 5 && !root.showing-detail; clicked => { root.page = 5; root.showing-detail = false; root.route-changed(5); } }
                        NavigationButton { name: "Onde Caçar"; artwork: @image-url("../../src/assets/pokeidle-theme/backgrounds/menu-hunt.png"); active: root.page == 1 && !root.showing-detail; clicked => { root.page = 1; root.showing-detail = false; root.route-changed(1); } }
                        NavigationButton { name: "Configurações"; artwork: @image-url("../../src/assets/pokeidle-theme/backgrounds/menu-settings.png"); active: root.page == 6 && !root.showing-detail; clicked => { root.page = 6; root.showing-detail = false; root.route-changed(6); } }
                        NavigationButton { name: "Comunidade"; artwork: @image-url("../../src/assets/pokeidle-theme/backgrounds/menu-community.png"); active: root.page == 7 && !root.showing-detail; clicked => { root.page = 7; root.showing-detail = false; root.route-changed(7); } }
                    }
                }
                Rectangle {
                    background: #172336;
                    vertical-stretch: 1;
                    Image {
                        source: @image-url("../../src/assets/pokeidle-theme/backgrounds/sidebar-wallpaper.png");
                        image-fit: cover;
                        width: parent.width;
                        height: parent.height;
                    }
                }
                Rectangle {
                    background: #251921;
                    height: 37px;
                    border-width: 1px;
                    border-color: #ae754b;
                    Text { text: "●  Núcleo local"; color: #b7e5aa; font-size: 13px; x: 14px; vertical-alignment: center; }
                }
            }
        }
        Rectangle {
            background: #1d1422;
            horizontal-stretch: 1;
            VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: 32px;
                    background: #241923;
                    border-width: 1px;
                    border-color: #654034;
                    Text { text: "POKEIDLE MANAGER  /  NATIVE DESKTOP"; color: #be9b91; x: 16px; vertical-alignment: center; font-size: 11px; letter-spacing: 1px; }
                }
                if root.showing-detail : PageBanner { title: root.current-account; }
                if !root.showing-detail && root.page == 0 : Rectangle {
                    height: 141px;
                    Image { source: @image-url("../../src/assets/pokeidle-theme/backgrounds/dashboard-scenery.png"); width: parent.width; height: parent.height; image-fit: cover; }
                    Image { x: 18px; y: 20px; source: @image-url("../../src/assets/pokeidle-theme/backgrounds/dashboard-titleboard.png"); width: 400px; height: 91px; image-fit: fill; }
                    HorizontalLayout {
                        x: parent.width - 365px;
                        y: 45px;
                        width: 352px;
                        height: 43px;
                        spacing: 8px;
                        WoodButton {
                            label: root.session-mode ? "Sessão" : "Resumo";
                            selected: root.session-mode;
                            clicked => { root.session-mode = !root.session-mode; }
                        }
                        WoodButton {
                            label: "+ Adicionar conta";
                            enabled: root.connect-next-available;
                            clicked => { root.connect-next-account(); }
                        }
                    }
                }
                if !root.showing-detail && root.page == 1 : PageBanner { title: "Onde Caçar"; }
                if !root.showing-detail && root.page == 2 : PageBanner { title: "Automações"; }
                if !root.showing-detail && root.page == 3 : PageBanner { title: "Inventários"; }
                if !root.showing-detail && root.page == 4 : PageBanner { title: "Mercado"; }
                if !root.showing-detail && root.page == 5 : PageBanner { title: "Lives"; }
                if !root.showing-detail && root.page == 6 : PageBanner { title: "Configurações"; }
                if !root.showing-detail && root.page == 7 : PageBanner { title: "Comunidade"; }

                ScrollView {
                    horizontal-scrollbar-policy: always-off;
                    vertical-scrollbar-policy: as-needed;
                    VerticalLayout {
                        padding: 22px;
                        spacing: 15px;

                        if root.showing-detail : VerticalLayout {
                            spacing: 13px;
                            HorizontalLayout {
                                WoodButton {
                                    label: "← Voltar ao Dashboard";
                                    clicked => { root.showing-detail = false; root.page = 0; }
                                }
                                Text {
                                    text: root.current-status;
                                    color: #a7e5b9;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.current-vip;
                                    color: #f4ce77;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                }
                            }
                            SectionHeading { label: root.current-account + "  •  " + root.current-level; }
                            FlexboxLayout {
                                spacing: 14px;
                                flex-wrap: wrap;
                                Rectangle {
                                    width: 350px; height: 273px;
                                    background: #422934; border-radius: 9px;
                                    border-color: #986044; border-width: 2px;
                                    VerticalLayout {
                                        padding: 11px; spacing: 5px;
                                        SectionHeading { label: "Informações da conta"; }
                                        DisplayRow {
                                            heading: "Nível do treinador";
                                            subheading: "Nível da conta";
                                            value: root.current-level;
                                        }
                                        DisplayRow {
                                            heading: "Gold / Gemas";
                                            subheading: "Saldos disponíveis";
                                            value: root.current-gold + " / " + root.current-orbs;
                                        }
                                        DisplayRow {
                                            heading: "Diamantes";
                                            subheading: "Saldo especial";
                                            value: root.current-diamonds;
                                        }
                                        Text {
                                            text: "Caçando: " + root.current-hunt;
                                            color: #f1d0ae;
                                            font-size: 13px;
                                        }
                                    }
                                }
                                Rectangle {
                                    width: 350px; height: 273px;
                                    background: #422934; border-radius: 9px;
                                    border-color: #986044; border-width: 2px;
                                    VerticalLayout {
                                        padding: 11px; spacing: 7px;
                                        SectionHeading { label: "Pokémon ativo"; }
                                        HorizontalLayout {
                                            spacing: 12px;
                                            Rectangle {
                                                width: 137px; height: 131px;
                                                background: #282033;
                                                border-radius: 6px;
                                                Image {
                                                    source: @image-url("../../src/assets/pokeidle-theme/backgrounds/pokemon-battle-backdrop.png");
                                                    width: parent.width;
                                                    height: parent.height;
                                                    image-fit: cover;
                                                }
                                                Image {
                                                    source: root.current-pokemon-art;
                                                    width: parent.width;
                                                    height: parent.height;
                                                    image-fit: contain;
                                                }
                                            }
                                            VerticalLayout {
                                                spacing: 7px;
                                                Text {
                                                    text: root.current-pokemon;
                                                    color: #fff0cd;
                                                    font-size: 20px;
                                                    font-weight: 760;
                                                }
                                                Text {
                                                    text: "Nv. " + root.current-pokemon-level;
                                                    color: #ecd2bd;
                                                }
                                                Text {
                                                    text: root.current-pokemon-types;
                                                    color: #abdda9;
                                                    font-size: 12px;
                                                }
                                                Text {
                                                    text: "Potência " + root.current-pokemon-power;
                                                    color: #f3c18c;
                                                }
                                                Text {
                                                    text: "Qualidade " + root.current-pokemon-quality;
                                                    color: #ead1b7;
                                                }
                                            }
                                        }
                                        DisplayRow {
                                            heading: "HP";
                                            subheading: "Saúde do Pokémon";
                                            value: root.current-pokemon-hp;
                                        }
                                        Text {
                                            text: "XP " + root.current-pokemon-xp;
                                            color: #b2e8c2;
                                            font-size: 12px;
                                        }
                                    }
                                }
                                Rectangle {
                                    width: 350px; height: 273px;
                                    background: #422934; border-radius: 9px;
                                    border-color: #986044; border-width: 2px;
                                    VerticalLayout {
                                        padding: 11px; spacing: 7px;
                                        SectionHeading { label: "Selvagem e farm"; }
                                        Text {
                                            text: root.current-wild;
                                            color: #fff0db;
                                            font-size: 18px;
                                            font-weight: 750;
                                        }
                                        DisplayRow {
                                            heading: "HP selvagem";
                                            subheading: "Encontro atual";
                                            value: root.current-wild-hp;
                                        }
                                        DisplayRow {
                                            heading: "Kills";
                                            subheading: "Total de combate";
                                            value: root.current-kills;
                                        }
                                        DisplayRow {
                                            heading: "Capturas";
                                            subheading: "Pokémon capturados";
                                            value: root.current-captures;
                                        }
                                    }
                                }
                                Rectangle {
                                    width: 350px; height: 250px;
                                    background: #422934; border-radius: 9px;
                                    border-color: #986044; border-width: 2px;
                                    VerticalLayout {
                                        padding: 11px; spacing: 7px;
                                        SectionHeading { label: "Métricas da hunt"; }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            MetricTile {
                                                title: "XP/h";
                                                value: root.current-xp-rate;
                                                artwork: @image-url("../../src/assets/pokeidle-theme/backgrounds/icon-level.png");
                                            }
                                            MetricTile {
                                                title: "Gold/h";
                                                value: root.current-gold-rate;
                                                artwork: @image-url("../../src/assets/pokeidle-theme/backgrounds/icon-gold.png");
                                            }
                                        }
                                        Text {
                                            text: "Poções/h  " + root.current-potion-rate +
                                                "    Balls usadas  " + root.current-balls-used;
                                            color: #debea7;
                                        }
                                    }
                                }
                                Rectangle {
                                    width: 350px; height: 250px;
                                    background: #422934; border-radius: 9px;
                                    border-color: #986044; border-width: 2px;
                                    VerticalLayout {
                                        padding: 11px; spacing: 7px;
                                        SectionHeading { label: "Automações"; }
                                        for automation in root.automations : HorizontalLayout {
                                            height: 27px;
                                            Text {
                                                text: automation.label;
                                                color: #f2dfcf;
                                                font-size: 13px;
                                            }
                                            Text {
                                                text: automation.enabled ? "Ativa" : "Desativada";
                                                color: automation.enabled ? #a5e7be : #ad9d9b;
                                                horizontal-alignment: right;
                                                font-size: 12px;
                                            }
                                        }
                                        WoodButton {
                                            label: "Configurar automações";
                                            clicked => {
                                                root.page = 2;
                                                root.showing-detail = false;
                                                root.route-changed(2);
                                            }
                                        }
                                    }
                                }
                                Rectangle {
                                    width: 350px; height: 250px;
                                    background: #422934; border-radius: 9px;
                                    border-color: #986044; border-width: 2px;
                                    VerticalLayout {
                                        padding: 11px; spacing: 5px;
                                        HorizontalLayout {
                                            SectionHeading { label: "Estatísticas da sessão"; }
                                            Text {
                                                text: root.current-session-time;
                                                color: #d5bcaa;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Text {
                                            text: "Trainer XP " + root.current-session-trainer-xp +
                                                "    Pokémon XP " + root.current-session-pokemon-xp;
                                            color: #b3e9be;
                                        }
                                        Text {
                                            text: "Gold " + root.current-session-gold +
                                                "    Kills " + root.current-session-kills;
                                            color: #f2d1a5;
                                        }
                                        Text {
                                            text: "Capturas " + root.current-session-captures +
                                                "    Shinies vistos " + root.current-shiny-seen +
                                                " / capturados " + root.current-shiny-captured;
                                            color: #eac7cf;
                                            font-size: 12px;
                                            wrap: word-wrap;
                                        }
                                        if !root.confirm-reset-session : WoodButton {
                                            label: "Resetar sessão";
                                            clicked => { root.confirm-reset-session = true; }
                                        }
                                        if root.confirm-reset-session : HorizontalLayout {
                                            WoodButton {
                                                label: "Confirmar reset";
                                                clicked => {
                                                    root.reset-session();
                                                    root.confirm-reset-session = false;
                                                }
                                            }
                                            WoodButton {
                                                label: "Cancelar";
                                                clicked => { root.confirm-reset-session = false; }
                                            }
                                        }
                                    }
                                }
                            }
                            SectionHeading { label: "Drops da sessão"; }
                            FlexboxLayout {
                                spacing: 8px;
                                flex-wrap: wrap;
                                for drop in root.session-drops : Rectangle {
                                    width: 176px;
                                    height: 58px;
                                    background: #3e2734;
                                    border-width: 1px;
                                    border-color: #88553c;
                                    border-radius: 6px;
                                    VerticalLayout {
                                        padding: 7px;
                                        Text { text: drop.label; color: #e9cdb7; font-size: 12px; }
                                        Text { text: drop.quantity; color: #ffca78; font-weight: 750; }
                                    }
                                }
                            }
                            HorizontalLayout {
                                WoodButton { label: "Centro Pokémon"; clicked => { root.return-center(); } }
                                WoodButton { label: "Onde Caçar"; clicked => { root.page = 1; root.showing-detail = false; root.route-changed(1); } }
                                WoodButton { label: "Inventários"; clicked => { root.page = 3; root.showing-detail = false; root.route-changed(3); } }
                            }
                        }

                        if !root.showing-detail && root.page == 0 : VerticalLayout {
                            spacing: 14px;
                            SectionHeading { label: "Visão geral das contas"; }
                            FlexboxLayout {
                                spacing: 10px;
                                flex-wrap: wrap;
                                MetricTile { title: "XP/h total"; value: root.total-xp; artwork: @image-url("../../src/assets/pokeidle-theme/backgrounds/icon-level.png"); }
                                MetricTile { title: "Gold/h total"; value: root.total-gold-rate; artwork: @image-url("../../src/assets/pokeidle-theme/backgrounds/icon-gold.png"); }
                                MetricTile { title: "Contas online"; value: root.connected-accounts; artwork: @image-url("../../src/assets/pokeidle-theme/backgrounds/icon-background.png"); }
                                MetricTile { title: "Gold total"; value: root.total-gold; artwork: @image-url("../../src/assets/pokeidle-theme/backgrounds/icon-gold.png"); }
                                MetricTile { title: "Gemas totais"; value: root.total-gems; artwork: @image-url("../../src/assets/pokeidle-theme/backgrounds/icon-diamond.png"); }
                            }
                            FlexboxLayout {
                                spacing: 16px;
                                flex-wrap: wrap;
                                for account[i] in root.accounts : AccountCard {
                                    item: account;
                                    session-mode: root.session-mode;
                                    details => { root.selected-account = i; root.selected-account-changed(i); root.showing-detail = true; }
                                    connect => { root.connect-account(i); }
                                }
                            }
                        }

                        if !root.showing-detail && root.page == 1 : VerticalLayout {
                            spacing: 13px;
                            HorizontalLayout {
                                SectionHeading { label: "Onde rende mais?"; }
                                Text { text: "Conta para simular"; color: #deb7a4; vertical-alignment: center; }
                                for account[i] in root.accounts : WoodButton {
                                    label: account.name;
                                    selected: root.selected-account == i;
                                    clicked => { root.selected-account = i; root.selected-account-changed(i); }
                                }
                            }
                            FlexboxLayout {
                                spacing: 12px;
                                flex-wrap: wrap;
                                Rectangle {
                                    width: 62%;
                                    min-width: 510px;
                                    height: 265px;
                                    background: #412b37;
                                    border-width: 2px;
                                    border-color: #a7644a;
                                    border-radius: 9px;
                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 8px;
                                        Text {
                                            text: "POKÉMON ATIVO";
                                            color: #f1c987;
                                            font-size: 13px;
                                            font-weight: 780;
                                        }
                                        HorizontalLayout {
                                            spacing: 15px;
                                            Rectangle {
                                                width: 119px;
                                                height: 119px;
                                                background: #282333;
                                                border-width: 1px;
                                                border-color: #8d6348;
                                                border-radius: 7px;
                                                Image {
                                                    source: @image-url("../../src/assets/pokeidle-theme/backgrounds/pokemon-battle-backdrop.png");
                                                    width: parent.width;
                                                    height: parent.height;
                                                    image-fit: cover;
                                                }
                                                Image {
                                                    source: root.current-pokemon-art;
                                                    width: parent.width;
                                                    height: parent.height;
                                                    image-fit: contain;
                                                }
                                            }
                                            VerticalLayout {
                                                spacing: 7px;
                                                Text {
                                                    text: root.current-pokemon;
                                                    color: #fff0db;
                                                    font-size: 21px;
                                                    font-weight: 790;
                                                }
                                                Text {
                                                    text: root.current-pokemon-level + " • Treinador " + root.current-level;
                                                    color: #e2c5aa;
                                                    font-size: 13px;
                                                }
                                                Text {
                                                    text: "QUALIDADE  " + root.current-pokemon-quality;
                                                    color: #f2d89f;
                                                    font-size: 14px;
                                                    font-weight: 750;
                                                }
                                                Text {
                                                    text: "POTÊNCIA  " + root.current-pokemon-power;
                                                    color: #dbaddc;
                                                    font-size: 14px;
                                                    font-weight: 750;
                                                }
                                                Text {
                                                    text: "Hunt atual: " + root.current-hunt;
                                                    color: #d3bdb1;
                                                    font-size: 12px;
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            HuntIvTile { label: "HP"; value: root.hunt-iv-hp; icon: @image-url("../../src/assets/pokeidle-theme/backgrounds/where-hunt-hp.png"); }
                                            HuntIvTile { label: "ATK"; value: root.hunt-iv-atk; icon: @image-url("../../src/assets/pokeidle-theme/backgrounds/where-hunt-attack.png"); }
                                            HuntIvTile { label: "DEF"; value: root.hunt-iv-def; icon: @image-url("../../src/assets/pokeidle-theme/backgrounds/where-hunt-defense.png"); }
                                            HuntIvTile { label: "SP.ATK"; value: root.hunt-iv-sp-atk; icon: @image-url("../../src/assets/pokeidle-theme/backgrounds/where-hunt-special-attack.png"); }
                                            HuntIvTile { label: "SP.DEF"; value: root.hunt-iv-sp-def; icon: @image-url("../../src/assets/pokeidle-theme/backgrounds/where-hunt-defense.png"); }
                                            HuntIvTile { label: "SPD"; value: root.hunt-iv-speed; icon: @image-url("../../src/assets/pokeidle-theme/backgrounds/where-hunt-speed.png"); }
                                        }
                                    }
                                }
                                Rectangle {
                                    width: 34%;
                                    min-width: 275px;
                                    height: 265px;
                                    background: #412b37;
                                    border-width: 2px;
                                    border-color: #a7644a;
                                    border-radius: 9px;
                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 6px;
                                        Text {
                                            text: "✦ BÔNUS CONSIDERADOS ✦";
                                            color: #ffdd9e;
                                            font-size: 15px;
                                            font-weight: 790;
                                            horizontal-alignment: center;
                                        }
                                        for bonus in root.hunt-bonuses : Rectangle {
                                            height: 28px;
                                            background: bonus.active ? #553b45 : #352832;
                                            border-color: #7e564c;
                                            border-width: 1px;
                                            HorizontalLayout {
                                                padding-left: 7px;
                                                padding-right: 7px;
                                                spacing: 6px;
                                                if bonus.kind == 0 : Image { source: @image-url("../../src/assets/pokeidle-theme/backgrounds/where-hunt-vip.png"); width: 23px; height: 23px; image-fit: contain; }
                                                if bonus.kind == 1 : Image { source: @image-url("../../src/assets/pokeidle-theme/backgrounds/where-hunt-guild.png"); width: 23px; height: 23px; image-fit: contain; }
                                                if bonus.kind == 2 : Image { source: @image-url("../../src/assets/pokeidle-theme/backgrounds/where-hunt-guild-boost.png"); width: 23px; height: 23px; image-fit: contain; }
                                                if bonus.kind == 3 : Image { source: @image-url("../../src/assets/pokeidle-theme/backgrounds/icon-twitch.png"); width: 23px; height: 23px; image-fit: contain; }
                                                if bonus.kind == 4 : Text { text: "✦"; color: #ffce7a; font-size: 18px; }
                                                Text {
                                                    text: bonus.label;
                                                    color: #f0d1bd;
                                                    vertical-alignment: center;
                                                    font-size: 12px;
                                                }
                                                Text {
                                                    text: bonus.value;
                                                    color: bonus.active ? #a5edbd : #a38b88;
                                                    font-weight: 800;
                                                    font-size: 12px;
                                                    horizontal-alignment: right;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                        Text {
                                            text: "Boosts não presentes no snapshot não são incluídos.";
                                            color: #c4a8a1;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                background: #3c2834;
                                border-width: 2px;
                                border-color: #9e6249;
                                border-radius: 9px;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 10px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        VerticalLayout {
                                            spacing: 4px;
                                            Text {
                                                text: "RECOMENDAÇÕES • " + root.hunt-result-count + " HUNTS";
                                                color: #e7bd84;
                                                font-size: 12px;
                                                font-weight: 750;
                                            }
                                            SectionHeading { label: "Onde rende mais?"; }
                                        }
                                        WoodButton { label: "XP Treinador"; selected: root.hunt-ranking-mode == 0; clicked => { root.hunt-ranking-mode = 0; } }
                                        WoodButton { label: "XP Pokémon"; selected: root.hunt-ranking-mode == 1; clicked => { root.hunt-ranking-mode = 1; } }
                                        WoodButton { label: "Ouro"; selected: root.hunt-ranking-mode == 2; clicked => { root.hunt-ranking-mode = 2; } }
                                    }
                                    HorizontalLayout {
                                        spacing: 12px;
                                        LineEdit {
                                            text <=> root.hunt-search;
                                            placeholder-text: "Buscar hunt ou região...";
                                            horizontal-stretch: 1;
                                        }
                                        Text { text: "Região"; color: #d6b8aa; vertical-alignment: center; }
                                        ComboBox {
                                            model: root.hunt-regions;
                                            current-value <=> root.hunt-region-filter;
                                            width: 210px;
                                        }
                                    }
                                    Text {
                                        text: root.hunt-model-status;
                                        color: #c5b1a1;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                    ListView {
                                        height: 475px;
                                        for hunt in root.hunts : Rectangle {
                                            height: 89px;
                                            background: hunt.current ? #5a3e49 : #3b2835;
                                            border-width: 1px;
                                            border-color: hunt.current ? #e5af58 : #8c5848;
                                            HorizontalLayout {
                                                padding: 9px;
                                                spacing: 10px;
                                                Text { text: hunt.rank; width: 29px; color: #edc984; font-size: 18px; font-weight: 800; vertical-alignment: center; }
                                                Rectangle {
                                                    width: 48px;
                                                    height: 48px;
                                                    background: #292538;
                                                    border-radius: 5px;
                                                    if hunt.has-primary-art : Image {
                                                        source: hunt.primary-art;
                                                        width: parent.width;
                                                        height: parent.height;
                                                        image-fit: contain;
                                                    }
                                                    if !hunt.has-primary-art : Image {
                                                        source: @image-url("../../src/assets/pokeidle-theme/backgrounds/icon-hunt.png");
                                                        width: parent.width;
                                                        height: parent.height;
                                                        image-fit: contain;
                                                    }
                                                }
                                                VerticalLayout {
                                                    spacing: 5px;
                                                    Text { text: hunt.name; font-size: 14px; font-weight: 760; color: #f7e2c0; }
                                                    Text { text: hunt.area + " • " + hunt.region + " • " + hunt.level; font-size: 12px; color: #d0b4a4; }
                                                    Text { text: hunt.confidence; font-size: 11px; color: #a7dab9; }
                                                }
                                                VerticalLayout {
                                                    spacing: 5px;
                                                    Text { text: root.hunt-ranking-mode == 1 ? "XP POKÉMON / H" : "XP TREINADOR / H"; color: #c7b19b; font-size: 10px; }
                                                    Text { text: root.hunt-ranking-mode == 1 ? hunt.xp-pokemon : hunt.xp-trainer; color: #fff3d2; font-size: 17px; font-weight: 750; }
                                                }
                                                VerticalLayout {
                                                    spacing: 5px;
                                                    Text { text: "OURO / H"; color: #c7b19b; font-size: 10px; }
                                                    Text { text: hunt.gold-rate; color: #ffcd82; font-size: 16px; font-weight: 750; }
                                                }
                                                VerticalLayout {
                                                    spacing: 5px;
                                                    Text { text: "ABATES / H"; color: #c7b19b; font-size: 10px; }
                                                    Text { text: hunt.kills-rate; color: #f0e0cb; font-size: 16px; font-weight: 750; }
                                                }
                                                VerticalLayout {
                                                    spacing: 5px;
                                                    Text { text: "TEMPO / ABATE"; color: #c7b19b; font-size: 10px; }
                                                    Text { text: hunt.seconds-per-kill; color: #f0e0cb; font-size: 16px; font-weight: 750; }
                                                }
                                                WoodButton {
                                                    label: hunt.current ? "Atual" : "Ir para hunt";
                                                    enabled: !hunt.current && root.current-status == "Online";
                                                    clicked => { root.travel(hunt.slug); }
                                                }
                                            }
                                        }
                                    }
                                    Text {
                                        text: "PROJEÇÃO, NÃO MEDIÇÃO • Modelo de combate sustentado do Hunt Atlas. XP de treinador e Pokémon separados; observações de HP só da hunt correspondente. Ouro exclui custos e mortes.";
                                        color: #c4aca5;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }

                        if !root.showing-detail && root.page == 2 : VerticalLayout {
                            spacing: 13px;
                            SectionHeading { label: "Controle das contas"; }
                            HorizontalLayout {
                                for account[i] in root.accounts : WoodButton {
                                    label: account.name;
                                    selected: root.selected-account == i;
                                    clicked => { root.selected-account = i; root.selected-account-changed(i); }
                                }
                            }
                            SectionHeading { label: "Movimentação"; }
                            Rectangle {
                                height: 82px; background: #3e2833; border-width: 2px; border-color: #925640; border-radius: 8px;
                                HorizontalLayout {
                                    padding: 12px; spacing: 12px;
                                    VerticalLayout {
                                        spacing: 4px;
                                        Text { text: "Hunt atual: " + root.current-hunt; color: #ffe9ce; font-size: 15px; font-weight: 700; }
                                        Text { text: "Troca de hunt respeita o bloqueio de combate"; color: #c9a29d; font-size: 12px; }
                                    }
                                    WoodButton { label: "Onde Caçar"; clicked => { root.page = 1; root.route-changed(1); } }
                                    WoodButton { label: "Ir ao Centro"; clicked => { root.return-center(); } }
                                }
                            }
                            SectionHeading { label: "Poções e Balls configuradas"; }
                            Rectangle {
                                height: 158px;
                                background: #422933; border-color: #955c46; border-width: 2px; border-radius: 8px;
                                VerticalLayout {
                                    padding: 12px; spacing: 8px;
                                    HorizontalLayout {
                                        Text { text: "IDs de poções"; color: #f2cfaa; vertical-alignment: center; }
                                        LineEdit { text <=> root.potion-selection; placeholder-text: "200,201"; horizontal-stretch: 1; }
                                        WoodButton { label: "Aplicar poções"; clicked => { root.save-combat-selection("potion", root.potion-selection); } }
                                    }
                                    HorizontalLayout {
                                        Text { text: "IDs de Balls"; color: #f2cfaa; vertical-alignment: center; }
                                        LineEdit { text <=> root.ball-selection; placeholder-text: "1,2,3"; horizontal-stretch: 1; }
                                        WoodButton { label: "Aplicar Balls"; clicked => { root.save-combat-selection("ball", root.ball-selection); } }
                                    }
                                    Text { text: "A seleção é confirmada pelo estado do jogo; usar IDs válidos do catálogo."; color: #bda19a; font-size: 12px; }
                                }
                            }
                            SectionHeading { label: "Automações da conta"; }
                            Rectangle {
                                height: 68px; background: #422933; border-color: #955c46; border-width: 2px; border-radius: 8px;
                                HorizontalLayout {
                                    padding: 10px; spacing: 12px;
                                    Text {
                                        text: "Usar Potion quando HP ≤ " + root.potion-threshold-percent + "%";
                                        color: #f2d4b6; font-weight: 700; vertical-alignment: center;
                                    }
                                    WoodButton {
                                        label: "− 10%";
                                        enabled: root.potion-threshold-percent > 10;
                                        clicked => { root.set-potion-threshold(root.potion-threshold-percent - 10); }
                                    }
                                    WoodButton {
                                        label: "+ 10%";
                                        enabled: root.potion-threshold-percent < 100;
                                        clicked => { root.set-potion-threshold(root.potion-threshold-percent + 10); }
                                    }
                                }
                            }
                            if root.automation-last-error != "" : Text {
                                text: root.automation-last-error;
                                color: #f0a79b;
                                wrap: word-wrap;
                            }
                            for automation in root.automations : ToggleRow {
                                item: automation;
                                toggled(key, value) => { root.toggle-automation(key, value); }
                            }
                            SectionHeading { label: "Reabastecimento por item"; }
                            Rectangle {
                                height: 143px;
                                background: #422933;
                                border-color: #965943;
                                border-width: 2px;
                                border-radius: 8px;
                                VerticalLayout {
                                    padding: 11px; spacing: 9px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        WoodButton {
                                            label: "Poções";
                                            selected: root.refill-kind == 0;
                                            clicked => { root.refill-kind = 0; }
                                        }
                                        WoodButton {
                                            label: "Balls";
                                            selected: root.refill-kind == 1;
                                            clicked => { root.refill-kind = 1; }
                                        }
                                        Text { text: "ID do item"; color: #e9c5ad; vertical-alignment: center; }
                                        LineEdit {
                                            text <=> root.refill-item-id;
                                            width: 100px;
                                            placeholder-text: "ID";
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 9px;
                                        Text { text: "Comprar abaixo de"; color: #e9c5ad; vertical-alignment: center; }
                                        LineEdit { text <=> root.refill-minimum; width: 100px; }
                                        Text { text: "Quantidade por compra"; color: #e9c5ad; vertical-alignment: center; }
                                        LineEdit { text <=> root.refill-quantity; width: 100px; }
                                        WoodButton { label: "Salvar limite"; clicked => { root.update-refill-rule(); } }
                                    }
                                    Text {
                                        text: "Os limites são por item e por conta; regras de compra desativadas não são ativadas automaticamente.";
                                        color: #bfa7a1;
                                        font-size: 12px;
                                    }
                                }
                            }
                            ListView {
                                height: 220px;
                                for entry in root.refill-rules : Rectangle {
                                    height: 58px;
                                    background: #3c2734;
                                    border-color: #8a523f;
                                    border-width: 1px;
                                    HorizontalLayout {
                                        padding: 8px;
                                        spacing: 10px;
                                        Text {
                                            text: entry.kind + " #" + entry.item-id;
                                            color: #ffe0bc;
                                            font-weight: 720;
                                        }
                                        Text {
                                            text: "Mín. " + entry.minimum +
                                                "   •   Compra " + entry.quantity +
                                                "   •   " + entry.status;
                                            color: #caada2;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                        }
                                        WoodButton {
                                            label: "Editar";
                                            clicked => {
                                                root.refill-kind = entry.kind == "Potion" ? 0 : 1;
                                                root.refill-item-id = entry.item-id;
                                                root.refill-minimum = entry.minimum;
                                                root.refill-quantity = entry.quantity;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        if !root.showing-detail && root.page == 3 : VerticalLayout {
                            spacing: 13px;
                            SectionHeading { label: "Bag e Depot"; }
                            HorizontalLayout {
                                WoodButton {
                                    label: "Todas as contas";
                                    selected: root.inventory-all-accounts;
                                    clicked => { root.inventory-all-accounts = true; }
                                }
                                for account[i] in root.accounts : WoodButton {
                                    label: account.name;
                                    selected: !root.inventory-all-accounts && root.selected-account == i;
                                    clicked => {
                                        root.inventory-all-accounts = false;
                                        root.selected-account = i;
                                        root.selected-account-changed(i);
                                    }
                                }
                            }
                            HorizontalLayout {
                                WoodButton { label: "Itens"; selected: root.inventory-tab == 0; clicked => { root.inventory-tab = 0; } }
                                WoodButton { label: "Balls"; selected: root.inventory-tab == 1; clicked => { root.inventory-tab = 1; } }
                                WoodButton { label: "Pokémon"; selected: root.inventory-tab == 2; clicked => { root.inventory-tab = 2; } }
                            }
                            HorizontalLayout {
                                Text { text: "Buscar"; vertical-alignment: center; color: #e0bba9; }
                                LineEdit { text <=> root.inventory-search; placeholder-text: "Nome ou ID"; horizontal-stretch: 1; }
                            }
                            if root.inventory-tab == 0 : HorizontalLayout {
                                spacing: 9px;
                                WoodButton { label: "Todos"; selected: root.inventory-category == 0; clicked => { root.inventory-category = 0; } }
                                WoodButton { label: "Potions"; selected: root.inventory-category == 1; clicked => { root.inventory-category = 1; } }
                                WoodButton { label: "Stones"; selected: root.inventory-category == 2; clicked => { root.inventory-category = 2; } }
                                WoodButton { label: "Outros"; selected: root.inventory-category == 3; clicked => { root.inventory-category = 3; } }
                            }
                            if root.inventory-tab == 2 : HorizontalLayout {
                                spacing: 9px;
                                Text { text: "Tipo"; color: #dcb9a9; vertical-alignment: center; }
                                LineEdit { text <=> root.pokemon-type-filter; width: 115px; placeholder-text: "Todos"; }
                                Text { text: "IV mínimo"; color: #dcb9a9; vertical-alignment: center; }
                                LineEdit { text <=> root.pokemon-min-iv; width: 95px; placeholder-text: "0"; }
                                WoodButton {
                                    label: root.pokemon-sort == 0 ? "Nível ↓" :
                                        root.pokemon-sort == 1 ? "Qualidade ↓" :
                                        root.pokemon-sort == 2 ? "Potência ↓" :
                                        root.pokemon-sort == 3 ? "IV ↓" :
                                        root.pokemon-sort == 4 ? "Nota ↓" :
                                        "Recentes ↓";
                                    clicked => { root.pokemon-sort = Math.mod(root.pokemon-sort + 1, 6); }
                                }
                                WoodButton {
                                    label: "Vender Depot";
                                    clicked => { root.confirm-sell-all = true; }
                                }
                            }
                            if root.confirm-sell-all : Rectangle {
                                height: 99px;
                                background: #572b37;
                                border-width: 2px;
                                border-color: #f1b365;
                                VerticalLayout {
                                    padding: 9px; spacing: 8px;
                                    Text {
                                        text: root.inventory-all-accounts
                                            ? "Confirma vender todos os Pokémon não protegidos de TODAS AS CONTAS? Esta ação é irreversível."
                                            : "Confirma vender todos os Pokémon não protegidos desta conta? Esta ação é irreversível.";
                                        color: #fff0cf;
                                        wrap: word-wrap;
                                    }
                                    HorizontalLayout {
                                        WoodButton { label: "Cancelar"; clicked => { root.confirm-sell-all = false; } }
                                        WoodButton { label: "Confirmar venda"; clicked => { root.sell-all-pokemon(); root.confirm-sell-all = false; } }
                                    }
                                }
                            }
                            if root.sale-id != "" : Rectangle {
                                height: 95px;
                                background: #572b37;
                                border-width: 2px;
                                border-color: #f1b365;
                                VerticalLayout {
                                    padding: 9px; spacing: 6px;
                                    Text {
                                        text: "Vender " + root.sale-name + "? Esta ação é irreversível.";
                                        color: #fff0cf;
                                    }
                                    HorizontalLayout {
                                        WoodButton { label: "Cancelar"; clicked => { root.sale-id = ""; } }
                                        WoodButton {
                                            label: "Confirmar";
                                            clicked => { root.sell-pokemon(root.sale-id); root.sale-id = ""; }
                                        }
                                    }
                                }
                            }
                            if root.inventory-tab != 2 : ScrollView {
                                height: 490px;
                                horizontal-scrollbar-policy: always-off;
                                vertical-scrollbar-policy: as-needed;
                                FlexboxLayout {
                                    spacing: 11px;
                                    flex-wrap: wrap;
                                    for entry in root.inventory : Rectangle {
                                        width: 168px; height: 162px;
                                        border-width: 2px;
                                        border-color: #995b46;
                                        border-radius: 9px;
                                        background: #402a37;
                                        VerticalLayout {
                                            padding: 9px; spacing: 6px;
                                            Rectangle {
                                                width: 70px; height: 70px;
                                                background: #282033;
                                                border-radius: 5px;
                                                if entry.has-artwork : Image {
                                                    source: entry.artwork;
                                                    width: parent.width;
                                                    height: parent.height;
                                                    image-fit: contain;
                                                }
                                                if !entry.has-artwork : Text {
                                                    text: "▣";
                                                    color: #e1b36c;
                                                    font-size: 25px;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            Text {
                                                text: entry.title;
                                                color: #ffead0;
                                                font-size: 12px;
                                                font-weight: 720;
                                                horizontal-alignment: center;
                                            }
                                            Text {
                                                text: entry.quantity;
                                                color: #ffcb73;
                                                font-size: 15px;
                                                font-weight: 740;
                                                horizontal-alignment: center;
                                            }
                                            Text {
                                                text: entry.details != "" ? entry.details : entry.category;
                                                color: #bca79e;
                                                font-size: 10px;
                                                horizontal-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                            if root.inventory-tab == 2 : ListView {
                                height: 500px;
                                for group in root.inventory-grid : HorizontalLayout {
                                    height: 243px;
                                    spacing: 11px;
                                    for entry in group.cells : Rectangle {
                                        width: 208px; height: 232px;
                                        background: #3e2835;
                                        border-width: 2px;
                                        border-color: entry.locked ? #7e7888 : #986044;
                                        border-radius: 9px;
                                        VerticalLayout {
                                            padding: 9px; spacing: 5px;
                                            Text {
                                                text: entry.owner;
                                                color: #cbb3a4;
                                                font-size: 12px;
                                                font-weight: 720;
                                            }
                                            Rectangle {
                                                height: 89px;
                                                background: #272330;
                                                border-radius: 5px;
                                                if entry.has-artwork : Image {
                                                    source: entry.artwork;
                                                    width: parent.width;
                                                    height: parent.height;
                                                    image-fit: contain;
                                                }
                                                if !entry.has-artwork : Text {
                                                    text: "◉";
                                                    color: #ebc582;
                                                    font-size: 31px;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            Text {
                                                text: entry.title;
                                                color: #ffedd2;
                                                font-size: 13px;
                                                font-weight: 750;
                                            }
                                            Text {
                                                text: entry.details;
                                                color: #cbb7a6;
                                                font-size: 11px;
                                                wrap: word-wrap;
                                            }
                                            WoodButton {
                                                label: entry.locked ? "Protegido" : "Vender";
                                                enabled: !entry.locked;
                                                height: 31px;
                                                clicked => {
                                                    root.sale-id = entry.id;
                                                    root.sale-name = entry.title + " — " + entry.owner;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        if !root.showing-detail && root.page == 4 : VerticalLayout {
                            spacing: 14px;
                            HorizontalLayout {
                                SectionHeading { label: "Análise do Mercado"; }
                                WoodButton { label: "Atualizar leitura"; clicked => { root.refresh-market(); } }
                            }
                            Text { text: root.market-status; color: #c9b4a3; }
                            HorizontalLayout {
                                spacing: 7px;
                                WoodButton { label: "Ofertas"; selected: root.market-view == 0; clicked => { root.market-view = 0; } }
                                WoodButton { label: "Histórico"; selected: root.market-view == 1; clicked => { root.market-view = 1; } }
                                WoodButton { label: "Mais vendidos"; selected: root.market-view == 2; clicked => { root.market-view = 2; } }
                                WoodButton { label: "Minhas compras"; selected: root.market-view == 3; clicked => { root.market-view = 3; } }
                            }
                            if root.market-view != 0 : Text {
                                text: root.market-history-status;
                                color: #d6baaf;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                            if root.market-view == 0 : Rectangle {
                                height: 39px; background: #593441; border-color: #ac6847; border-width: 2px;
                                HorizontalLayout {
                                    padding: 10px;
                                    Text { text: "Item"; color: #ffe8cc; font-weight: 700; }
                                    Text { text: "Ofertas"; color: #ffe8cc; font-weight: 700; }
                                    Text { text: "Unidades"; color: #ffe8cc; font-weight: 700; }
                                    Text { text: "Gold mínimo"; color: #ffe8cc; font-weight: 700; }
                                    Text { text: "Orbs"; color: #ffe8cc; font-weight: 700; }
                                }
                            }
                            if root.market-view == 0 : ListView {
                                height: 490px;
                                for entry in root.market : Rectangle {
                                    height: 49px; background: #392733; border-width: 1px; border-color: #6f4c41;
                                    HorizontalLayout {
                                        padding: 10px;
                                        Text { text: entry.name; color: #ffebcb; }
                                        Text { text: entry.listings; color: #d0b0a3; }
                                        Text { text: entry.quantity; color: #d0b0a3; }
                                        Text { text: entry.gold; color: #ffcd77; }
                                        Text { text: entry.orbs; color: #d7b8ea; }
                                    }
                                }
                            }
                            if root.market-view == 1 : ListView {
                                height: 490px;
                                for entry in root.market-history : Rectangle {
                                    height: 70px; background: #3b2734; border-width: 1px; border-color: #885743;
                                    HorizontalLayout {
                                        padding: 9px; spacing: 10px;
                                        VerticalLayout {
                                            spacing: 5px;
                                            Text { text: entry.item; color: #ffebce; font-size: 14px; font-weight: 720; }
                                            Text { text: entry.participants; color: #c9aaa7; font-size: 12px; }
                                        }
                                        VerticalLayout {
                                            spacing: 5px;
                                            Text { text: entry.amount + " " + entry.currency; color: #f1c778; font-weight: 700; horizontal-alignment: right; }
                                            Text { text: entry.date; color: #bdac9e; font-size: 12px; horizontal-alignment: right; }
                                        }
                                    }
                                }
                            }
                            if root.market-view == 2 : ListView {
                                height: 490px;
                                for entry in root.market-top-sales : Rectangle {
                                    height: 65px; background: #3b2734; border-width: 1px; border-color: #885743;
                                    HorizontalLayout {
                                        padding: 9px; spacing: 12px;
                                        Text { text: entry.item; color: #ffeac7; font-weight: 730; horizontal-stretch: 1; }
                                        Text { text: entry.count + " vendas"; color: #d1b4a4; }
                                        Text { text: entry.quantity + " unidades"; color: #d1b4a4; }
                                        Text { text: entry.average; color: #e9c476; }
                                    }
                                }
                            }
                            if root.market-view == 3 : ListView {
                                height: 490px;
                                for entry in root.market-purchases : Rectangle {
                                    height: 71px; background: #3b2734; border-width: 1px; border-color: #885743;
                                    HorizontalLayout {
                                        padding: 9px; spacing: 12px;
                                        VerticalLayout {
                                            spacing: 4px;
                                            Text { text: entry.item; color: #ffebce; font-weight: 700; }
                                            Text { text: entry.outcome; color: #cfaea1; font-size: 12px; }
                                        }
                                        Text { text: entry.quantity + " unidades"; color: #e5c9ae; vertical-alignment: center; }
                                        Text { text: entry.cost + " " + entry.currency; color: #ffc974; vertical-alignment: center; }
                                    }
                                }
                            }
                                                        SectionHeading { label: "Compra automática — Sniper"; }
                            HorizontalLayout {
                                Text { text: "Conta"; color: #ebc9b5; vertical-alignment: center; }
                                for account[i] in root.accounts : WoodButton {
                                    label: account.name;
                                    selected: root.selected-account == i;
                                    clicked => { root.selected-account = i; root.selected-account-changed(i); }
                                }
                            }
                            Rectangle {
                                height: 151px; background: #422733; border-width: 2px; border-color: #8f5441; border-radius: 8px;
                                VerticalLayout {
                                    padding: 12px; spacing: 9px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: "ID do item"; color: #ddbaa8; vertical-alignment: center; }
                                        LineEdit { text <=> root.sniper-item-id; width: 120px; placeholder-text: "Ex.: 70032"; }
                                        Text { text: "Preço máx. / unidade"; color: #ddbaa8; vertical-alignment: center; }
                                        LineEdit { text <=> root.sniper-max-price; width: 125px; placeholder-text: "Preço"; }
                                        WoodButton { label: root.sniper-currency == 0 ? "Gold" : "Orbs";
                                            clicked => { root.sniper-currency = root.sniper-currency == 0 ? 1 : 0; } }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: "Orçamento (0=sem limite)"; color: #ddbaa8; vertical-alignment: center; }
                                        LineEdit { text <=> root.sniper-budget; width: 130px; }
                                        Text { text: "Saldo mínimo"; color: #ddbaa8; vertical-alignment: center; }
                                        LineEdit { text <=> root.sniper-min-balance; width: 130px; }
                                        WoodButton { label: "Salvar regra"; clicked => { root.save-sniper-rule(); } }
                                    }
                                    Text { text: "O núcleo nativo processa ofertas e confirma compras pelo protocolo. Orçamento e saldo mínimo são por conta."; color: #b8a3a0; font-size: 12px; wrap: word-wrap; }
                                }
                            }
                            SectionHeading { label: "Regras configuradas"; }
                            ListView {
                                height: 300px;
                                for rule in root.sniper-rules : Rectangle {
                                    height: 73px; background: #392633; border-width: 1px; border-color: #965747;
                                    HorizontalLayout {
                                        padding: 10px; spacing: 12px;
                                        VerticalLayout {
                                            spacing: 5px;
                                            Text { text: rule.label; color: #fff0d1; font-size: 14px; font-weight: 700; }
                                            Text { text: "Máx. " + rule.price + "   •   Orçamento " + rule.budget +
                                                "   •   Gasto " + rule.spent + "   •   Comprado " + rule.quantity; color: #ceb2a6; font-size: 12px; }
                                        }
                                        WoodButton {
                                            label: rule.enabled ? "Ativa" : "Pausada";
                                            selected: rule.enabled;
                                            clicked => { root.toggle-sniper-rule(rule.id, !rule.enabled); }
                                        }
                                        WoodButton { label: "Excluir"; clicked => { root.delete-sniper-rule(rule.id); } }
                                    }
                                }
                            }
                        }

                        if !root.showing-detail && root.page == 5 : VerticalLayout {
                            spacing: 14px;
                            HorizontalLayout {
                                SectionHeading { label: "Acompanhe quem está ao vivo"; }
                                Text {
                                    text: root.twitch-irc-status;
                                    color: #a8ddbf;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                }
                            }
                            Rectangle {
                                height: 60px;
                                background: #412b37;
                                border-width: 1px;
                                border-color: root.lives-stale ? #ddad75 : #996148;
                                border-radius: 7px;
                                HorizontalLayout {
                                    padding: 10px;
                                    spacing: 9px;
                                    Text {
                                        text: root.lives-stale ? "●  Dados desatualizados" : "●  Núcleo local";
                                        color: root.lives-stale ? #f2b680 : #afe6bc;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: root.lives-source-status;
                                        color: #edd6bc;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: root.lives-updated-at;
                                        color: #d0b8a8;
                                        vertical-alignment: center;
                                        horizontal-alignment: right;
                                    }
                                }
                            }
                            if root.lives-stale : Text {
                                text: "A conexão da conta leitora pode ter sido interrompida. Os últimos dados permanecem visíveis.";
                                color: #ecc491;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 14px;
                                Rectangle {
                                    width: 49%;
                                    background: #372632;
                                    border-color: #995c49;
                                    border-width: 2px;
                                    border-radius: 8px;
                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 10px;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Image {
                                                source: @image-url("../../src/assets/pokeidle-theme/backgrounds/icon-twitch.png");
                                                width: 38px; height: 38px; image-fit: contain;
                                            }
                                            VerticalLayout {
                                                spacing: 4px;
                                                Text { text: "TRANSMISSÕES ATIVAS"; color: #bda69e; font-size: 11px; }
                                                SectionHeading { label: "Twitch"; }
                                            }
                                            Text {
                                                text: root.twitch-live-count;
                                                color: #ffe7c3;
                                                font-size: 20px;
                                                font-weight: 780;
                                                horizontal-alignment: right;
                                                vertical-alignment: center;
                                            }
                                        }
                                        ListView {
                                            height: 430px;
                                            for channel in root.twitch-lives : LiveStreamCard {
                                                item: channel;
                                                open(platform, slug) => { root.open-stream(platform, slug); }
                                            }
                                        }
                                        if root.twitch-live-count == "0" : Text {
                                            text: "Nenhuma live da Twitch está online no momento.";
                                            color: #c6ada5;
                                            font-size: 12px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                                Rectangle {
                                    width: 49%;
                                    background: #372632;
                                    border-color: #995c49;
                                    border-width: 2px;
                                    border-radius: 8px;
                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 10px;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Rectangle {
                                                width: 38px;
                                                height: 38px;
                                                background: #377747;
                                                border-radius: 6px;
                                                Text {
                                                    text: "K";
                                                    font-size: 25px;
                                                    font-weight: 850;
                                                    color: #fff5cf;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            VerticalLayout {
                                                spacing: 4px;
                                                Text { text: "TRANSMISSÕES ATIVAS"; color: #bda69e; font-size: 11px; }
                                                SectionHeading { label: "Kick"; }
                                            }
                                            Text {
                                                text: root.kick-live-count;
                                                color: #ffe7c3;
                                                font-size: 20px;
                                                font-weight: 780;
                                                horizontal-alignment: right;
                                                vertical-alignment: center;
                                            }
                                        }
                                        ListView {
                                            height: 430px;
                                            for channel in root.kick-lives : LiveStreamCard {
                                                item: channel;
                                                open(platform, slug) => { root.open-stream(platform, slug); }
                                            }
                                        }
                                        if root.kick-live-count == "0" : Text {
                                            text: "Nenhuma live da Kick está online no momento.";
                                            color: #c6ada5;
                                            font-size: 12px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                            Text {
                                text: "A lista é obtida pelo estado do jogo. Twitch IRC é um canal separado e não prova bônus de visualização.";
                                color: #c8b0a7;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }

                        if !root.showing-detail && root.page == 6 : VerticalLayout {
                            spacing: 14px;
                            SectionHeading { label: "Configurações"; }
                            SectionHeading { label: "Atualização da interface"; }
                            Text {
                                text: "Define a frequência de redesenho. O jogo mantém o próprio WebSocket, sem afetar coleta ou automações.";
                                color: #c5aea7;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 9px;
                                WoodButton {
                                    label: "Rápido · 1s";
                                    selected: root.ui-refresh-seconds == 1;
                                    clicked => { root.save-native-settings(1, root.restore-profiles-on-launch); }
                                }
                                WoodButton {
                                    label: "Normal · 2s";
                                    selected: root.ui-refresh-seconds == 2;
                                    clicked => { root.save-native-settings(2, root.restore-profiles-on-launch); }
                                }
                                WoodButton {
                                    label: "Econômico · 5s";
                                    selected: root.ui-refresh-seconds == 5;
                                    clicked => { root.save-native-settings(5, root.restore-profiles-on-launch); }
                                }
                            }
                            SectionHeading { label: "Inicialização"; }
                            Rectangle {
                                height: 97px;
                                background: #402733;
                                border-width: 2px;
                                border-color: #90543f;
                                border-radius: 8px;
                                HorizontalLayout {
                                    padding: 13px; spacing: 14px;
                                    VerticalLayout {
                                        spacing: 5px;
                                        Text {
                                            text: "Restaurar os perfis habilitados";
                                            color: #f9dfbd;
                                            font-weight: 720;
                                        }
                                        Text {
                                            text: "Usa accounts.json do Moth Controller no próximo início; abre Firefox temporariamente e fecha após welcome.";
                                            color: #bba9a1;
                                            font-size: 12px;
                                            wrap: word-wrap;
                                        }
                                    }
                                    WoodButton {
                                        label: root.restore-profiles-on-launch ? "Automático" : "Manual";
                                        selected: root.restore-profiles-on-launch;
                                        clicked => {
                                            root.save-native-settings(
                                                root.ui-refresh-seconds, !root.restore-profiles-on-launch
                                            );
                                        }
                                    }
                                }
                            }
                            DisplayRow { heading: "Versão do backend nativo"; subheading: "Rust / Slint"; value: root.native-version; }
                            DisplayRow { heading: "Renderizador"; subheading: "Interface desktop nativa"; value: "Slint / Rust"; }
                            DisplayRow { heading: "Navegador"; subheading: "Apenas para autenticação"; value: "Firefox BiDi"; }
                            DisplayRow { heading: "Game WebSocket"; subheading: "Sem WebView2 ou Tauri"; value: "Rust nativo"; }
                            DisplayRow { heading: "Perfis"; subheading: "Moth Controller, Game1–Game4"; value: "27701–27704"; }
                            SectionHeading { label: "Desenvolvimento"; }
                            Rectangle {
                                background: #422b35;
                                border-color: #945a47;
                                border-width: 2px;
                                border-radius: 8px;
                                height: 86px;
                                HorizontalLayout {
                                    padding: 11px;
                                    spacing: 12px;
                                    VerticalLayout {
                                        spacing: 5px;
                                        Text {
                                            text: "Modo Desenvolvedor";
                                            color: #fce5c4;
                                            font-size: 16px;
                                            font-weight: 750;
                                        }
                                        Text {
                                            text: "Captura até 500 frames sanitizados na memória por conta.";
                                            color: #c8ada3;
                                            font-size: 12px;
                                            wrap: word-wrap;
                                        }
                                    }
                                    WoodButton {
                                        label: root.developer-mode ? "Ativado" : "Desativado";
                                        selected: root.developer-mode;
                                        clicked => { root.toggle-developer-mode(!root.developer-mode); }
                                    }
                                }
                            }
                            if root.developer-mode : VerticalLayout {
                                spacing: 12px;
                                SectionHeading { label: "Protocol Inspector"; }
                                Text {
                                    text: "Frames locais de jogo • " + root.protocol-count +
                                        " • clique em um frame para copiar o conteúdo sanitizado";
                                    color: #d4b5a7;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: "Conta"; color: #e9c7b1; vertical-alignment: center; }
                                    for account[i] in root.accounts : WoodButton {
                                        label: account.name;
                                        selected: root.selected-account == i;
                                        clicked => {
                                            root.selected-account = i;
                                            root.selected-account-changed(i);
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    WoodButton {
                                        label: "Todos";
                                        selected: root.protocol-direction == 0;
                                        clicked => { root.protocol-direction = 0; }
                                    }
                                    WoodButton {
                                        label: "C → S";
                                        selected: root.protocol-direction == 1;
                                        clicked => { root.protocol-direction = 1; }
                                    }
                                    WoodButton {
                                        label: "S → C";
                                        selected: root.protocol-direction == 2;
                                        clicked => { root.protocol-direction = 2; }
                                    }
                                    LineEdit {
                                        text <=> root.protocol-search;
                                        placeholder-text: "Filtrar frames";
                                        horizontal-stretch: 1;
                                    }
                                    WoodButton {
                                        label: root.protocol-paused ? "Retomar" : "Pausar";
                                        selected: root.protocol-paused;
                                        clicked => { root.protocol-paused = !root.protocol-paused; }
                                    }
                                    WoodButton {
                                        label: "Limpar";
                                        clicked => { root.clear-protocol-frames(); }
                                    }
                                }
                                ListView {
                                    height: 425px;
                                    for frame in root.protocol-frames : Rectangle {
                                        height: 66px;
                                        background: #352934;
                                        border-width: 1px;
                                        border-color: #785a4c;
                                        HorizontalLayout {
                                            padding: 9px;
                                            spacing: 10px;
                                            Text {
                                                text: frame.stamp;
                                                width: 90px;
                                                color: #c6b5ae;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: frame.direction;
                                                width: 55px;
                                                color: frame.direction == "C → S" ? #9cdabf : #edd298;
                                                font-weight: 750;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: frame.preview;
                                                color: #ddc9c0;
                                                font-size: 12px;
                                                wrap: word-wrap;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                            }
                                        }
                                        TouchArea {
                                            clicked => { root.copy-protocol-frame(frame.payload); }
                                        }
                                    }
                                }
                            }
                            SectionHeading { label: "Estado do núcleo"; }
                            Text { text: root.status-line; color: #c5e4b9; wrap: word-wrap; }
                        }

                        if !root.showing-detail && root.page == 7 : VerticalLayout {
                            spacing: 14px;
                            SectionHeading { label: "Pokeidle Manager — Projeto comunitário"; }
                            Rectangle {
                                height: 180px; background: #3c2835; border-color: #9c6449; border-width: 2px; border-radius: 9px;
                                VerticalLayout {
                                    padding: 18px; spacing: 11px;
                                    Text { text: "Pokeidle Manager"; color: #ffe2a2; font-size: 25px; font-weight: 800; }
                                    Text { text: "Cliente comunitário não oficial para gerenciar contas do Pokeidle."; color: #e2c0b2; wrap: word-wrap; }
                                    Text { text: "Interface original: DiuleJR. Port nativo e integração Moth: MOTHblank."; color: #d0b0a1; }
                                    WoodButton { label: "Ver projeto no GitHub"; clicked => { root.open-community(); } }
                                }
                            }
                        }
                    }
                }
                Rectangle {
                    height: 29px;
                    background: #251b25;
                    border-color: #5c3e38;
                    border-width: 1px;
                    Text { text: root.status-line; x: 12px; color: #d3ac8f; font-size: 11px; vertical-alignment: center; overflow: elide; }
                }
            }
        }
    }
}
