export component WoodButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback clicked;
    height: 39px;
    min-width: 112px;
    border-width: 2px;
    border-radius: 6px;
    border-color: selected ? #f9d878 : #935541;
    background: !enabled ? #49343b : selected ? #79388e : touch.has-hover ? #804535 : #5c3236;
    Text {
        text: root.label;
        color: !root.enabled ? #b79e9d : #fff0d5;
        font-size: 13px;
        font-weight: 650;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}
